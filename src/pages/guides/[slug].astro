---
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import { guides, tierLabels } from "@/custom/guides";
import type { Guide } from "@/custom/guides";
import { getPicks, amazonUrl } from "@/custom/picks";
import { DEMO_PICKS } from "@/custom/siteFlags";
import config from "@/config";

export function getStaticPaths() {
  return guides.map(guide => ({
    params: { slug: guide.slug },
    props: { guide },
  }));
}

const { guide } = Astro.props as { guide: Guide };
const locale = Astro.currentLocale ?? config.site.lang;
const others = guides.filter(g => g.slug !== guide.slug).slice(0, 3);
const tierKeys = ["small", "upgrade", "saving"] as const;
const visibleTiers = tierKeys.filter(key => guide.tiers[key].length > 0);
const guidePicks = getPicks(guide.slug);
---

<Layout
  title={`${guide.title} | ${config.site.title}`}
  description={guide.summary}
>
  <Header wide />
  <main id="main-content" class="mx-auto my-1 w-full max-w-6xl px-4 pb-12">
    <a
      href={getRelativeLocaleUrl(locale, "guides")}
      class="text-accent mt-6 inline-block text-sm no-underline hover:underline"
    >
      All guides
    </a>

    <div
      class="guide"
      style={`--guide:${guide.color};--guide-ink:${guide.ink}`}
    >
      <header
        class="guide-wash relative mt-4 overflow-hidden rounded-2xl p-8 sm:p-12"
      >
        {
          guide.image && (
            <>
              <img
                src={guide.image}
                alt=""
                aria-hidden="true"
                class="absolute inset-0 h-full w-full object-cover opacity-45"
                style={`object-position: ${guide.imagePosition ?? "center"}`}
              />
              <div class="from-background/85 via-background/40 absolute inset-0 bg-gradient-to-r to-transparent" />
            </>
          )
        }
        <div class="relative">
          <div class="flex flex-wrap items-center gap-2">
            {
              guide.audience.map(a => (
                <span class="bg-background/70 rounded-full px-3 py-1 text-xs font-medium">
                  {a}
                </span>
              ))
            }
          </div>
          <h1 class="font-display mt-3 text-4xl font-medium sm:text-5xl">
            {guide.title}
          </h1>
          <span class="guide-route mt-4"></span>
          <p class="font-display mt-4 max-w-xl text-2xl leading-snug italic">
            {guide.wonder}
          </p>
          <p class="mt-4 max-w-xl text-base leading-relaxed">{guide.intro}</p>
          {
            guide.image && (
              <a
                href={`https://www.pinterest.com/pin/create/button/?url=${encodeURIComponent(Astro.url.href)}&media=${encodeURIComponent(new URL(guide.image, Astro.url).href)}&description=${encodeURIComponent(`${guide.title}: ${guide.summary}`)}`}
                target="_blank"
                rel="noopener"
                class="bg-accent text-accent-foreground mt-5 mr-3 inline-block rounded-full px-4 py-2 text-sm font-semibold no-underline"
              >
                Save to Pinterest
              </a>
            )
          }
          <p class="guide-note mt-4 text-base">
            From one travel heart to another.
          </p>
        </div>
      </header>

      {
        guidePicks.length > 0 && (
          <section class="mt-8">
            <h2 class="font-display text-3xl font-medium">Our picks</h2>
            {DEMO_PICKS && (
              <p class="bg-gold/30 mt-2 inline-block rounded-full px-3 py-1 text-xs font-medium">
                Demo preview: product links are not live
              </p>
            )}
            <p class="text-muted-foreground mt-2 max-w-2xl text-sm leading-relaxed">
              As an Amazon Associate I earn from qualifying purchases. Links
              below are affiliate links. Prices change, so check the current
              price on the retailer's page.
            </p>
            <div class="mt-4 columns-1 gap-4 sm:columns-2 lg:columns-3">
              {guidePicks.map(pick => (
                <div class="border-border guide-card mb-4 break-inside-avoid rounded-2xl border p-5">
                  {!pick.imageUrl && DEMO_PICKS && (
                    <div class="guide-wash text-muted-foreground mb-4 flex aspect-2/3 w-full items-center justify-center rounded-xl text-xs font-medium">
                      Product photo
                    </div>
                  )}
                  {pick.imageUrl && (
                    <img
                      src={pick.imageUrl}
                      alt={pick.name}
                      loading="lazy"
                      class="mb-4 aspect-2/3 w-full rounded-xl object-contain"
                    />
                  )}
                  <p class="guide-text text-xs font-semibold">
                    {tierLabels[pick.tier].name} · {pick.item}
                  </p>
                  <h3 class="font-display mt-1 text-xl font-medium">
                    {pick.name}
                  </h3>
                  <p class="mt-2 text-sm leading-relaxed">{pick.why}</p>
                  {pick.watchFor && (
                    <p class="text-muted-foreground mt-2 text-sm leading-relaxed">
                      Worth knowing: {pick.watchFor}
                    </p>
                  )}
                  <a
                    href={amazonUrl(pick.asin as string)}
                    rel="sponsored nofollow noopener"
                    target="_blank"
                    class="guide-wash guide-text mt-4 inline-block rounded-full px-4 py-2 text-sm font-semibold no-underline"
                  >
                    See it on Amazon.ca
                  </a>
                </div>
              ))}
            </div>
          </section>
        )
      }

      {
        guidePicks.length > 0 && (
          <section class="mt-8">
            <h2 class="font-display text-2xl font-medium">At a glance</h2>
            <div class="border-border mt-3 overflow-x-auto rounded-2xl border">
              <table class="w-full text-left text-sm">
                <thead class="guide-wash">
                  <tr>
                    <th class="px-4 py-3 font-medium">For</th>
                    <th class="px-4 py-3 font-medium">Our pick</th>
                    <th class="px-4 py-3 font-medium">Budget</th>
                  </tr>
                </thead>
                <tbody>
                  {guidePicks.map(pick => (
                    <tr class="border-border border-t">
                      <td class="px-4 py-3">{pick.item}</td>
                      <td class="px-4 py-3 font-medium">{pick.name}</td>
                      <td class="text-muted-foreground px-4 py-3">
                        {tierLabels[pick.tier].range}
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </section>
        )
      }

      <details class="mt-10 max-w-3xl">
        <summary
          class="guide-text font-display cursor-pointer text-2xl font-medium"
        >
          Good to know before you buy
        </summary>
        <div class="mt-4">
          {
            guide.sections.map(section => (
              <section class="mb-8">
                <h2 class="font-display text-2xl font-medium">
                  {section.heading}
                </h2>
                <ul class="mt-3 list-disc space-y-2 pl-5 leading-relaxed">
                  {section.points.map(point => (
                    <li>{point}</li>
                  ))}
                </ul>
              </section>
            ))
          }

          {
            (guide.forHer || guide.forHim) && (
              <div class="mb-8 grid gap-4 sm:grid-cols-2">
                {guide.forHer && (
                  <div class="guide-wash rounded-2xl p-6">
                    <h2 class="font-display text-xl font-medium">For her</h2>
                    <ul class="mt-2 list-disc space-y-1.5 pl-5 text-sm leading-relaxed">
                      {guide.forHer.map(item => (
                        <li>{item}</li>
                      ))}
                    </ul>
                  </div>
                )}
                {guide.forHim && (
                  <div class="bg-muted rounded-2xl p-6">
                    <h2 class="font-display text-xl font-medium">For him</h2>
                    <ul class="mt-2 list-disc space-y-1.5 pl-5 text-sm leading-relaxed">
                      {guide.forHim.map(item => (
                        <li>{item}</li>
                      ))}
                    </ul>
                  </div>
                )}
              </div>
            )
          }
        </div>
      </details>

      <section class="mt-2">
        <h2 class="font-display text-2xl font-medium">
          What to look for, by budget
        </h2>
        <div
          class:list={[
            "mt-4 grid gap-4",
            visibleTiers.length > 1 ? "md:grid-cols-3" : "",
          ]}
        >
          {
            visibleTiers.map(key => (
              <div class="border-border guide-card rounded-2xl border p-6">
                <p class="guide-text text-xs font-semibold">
                  {tierLabels[key].range}
                </p>
                <h3 class="font-display mt-1 text-xl font-medium">
                  {tierLabels[key].name}
                </h3>
                <ul class="mt-3 list-disc space-y-1.5 pl-5 text-sm leading-relaxed">
                  {guide.tiers[key].map(item => (
                    <li>{item}</li>
                  ))}
                </ul>
              </div>
            ))
          }
        </div>
      </section>

      {
        guidePicks.length > 0 && (
          <section class="bg-muted mt-10 max-w-3xl rounded-2xl p-6">
            <h2 class="font-display text-xl font-medium">How we choose</h2>
            <p class="mt-2 text-sm leading-relaxed">
              We start with the things travelers buy most, keep only those with
              strong reviews from a large number of buyers, and read what
              independent testers say. We tell you plainly when we have not
              tried something yet. We do not show prices, because they change.
            </p>
          </section>
        )
      }

      {
        guide.rules && (
          <section class="bg-muted mt-10 max-w-3xl rounded-2xl p-6">
            <h2 class="font-display text-xl font-medium">
              Travel rules to know
            </h2>
            {guide.rules.map(rule => (
              <div class="mt-3 text-sm leading-relaxed">
                <p>{rule.text}</p>
                <p class="text-muted-foreground mt-1 text-xs">
                  Source: <a href={rule.url}>{rule.source}</a>. Last checked{" "}
                  {rule.lastChecked}. Rules change, so confirm with your airline
                  and airport before you travel.
                </p>
              </div>
            ))}
          </section>
        )
      }

      <section class="border-border mt-12 border-t pt-8">
        <h2 class="font-display text-2xl font-medium">Keep exploring</h2>
        <p class="guide-note mt-1">Where to next?</p>
        <div class="mt-4 grid gap-4 sm:grid-cols-3">
          {
            others.map(g => (
              <a
                href={getRelativeLocaleUrl(locale, `guides/${g.slug}`)}
                style={`--guide:${g.color};--guide-ink:${g.ink}`}
                class="guide guide-wash guide-card block rounded-2xl p-5 no-underline"
              >
                <h3 class="font-display mt-3 text-xl font-medium">{g.title}</h3>
                <p class="mt-1 text-sm">{g.summary}</p>
              </a>
            ))
          }
        </div>
      </section>
    </div>
  </main>
  <Footer wide />
</Layout>
