---
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import { guides, tierLabels } from "@/custom/guides";
import type { Guide } from "@/custom/guides";
import config from "@/config";

export function getStaticPaths() {
  return guides.map(guide => ({
    params: { slug: guide.slug },
    props: { guide },
  }));
}

const { guide } = Astro.props as { guide: Guide };
const locale = Astro.currentLocale ?? config.site.lang;
const others = guides.filter(g => g.slug !== guide.slug).slice(0, 3);
const tierKeys = ["small", "upgrade", "saving"] as const;
const visibleTiers = tierKeys.filter(key => guide.tiers[key].length > 0);
---

<Layout
  title={`${guide.title} | ${config.site.title}`}
  description={guide.summary}
>
  <Header wide />
  <main id="main-content" class="mx-auto my-1 w-full max-w-6xl px-4 pb-12">
    <a
      href={getRelativeLocaleUrl(locale, "guides")}
      class="text-accent mt-6 inline-block text-sm no-underline hover:underline"
    >
      All guides
    </a>

    <header class:list={["mt-4 rounded-2xl p-8 sm:p-10", guide.tint]}>
      <div class="flex flex-wrap gap-2">
        {
          guide.audience.map(a => (
            <span class="bg-background/70 rounded-full px-3 py-1 text-xs font-medium">
              {a}
            </span>
          ))
        }
      </div>
      <h1 class="font-display mt-3 text-4xl font-medium">{guide.title}</h1>
      <p class="mt-3 max-w-2xl text-lg leading-relaxed">{guide.intro}</p>
    </header>

    <div class="mt-10 max-w-3xl">
      {
        guide.sections.map(section => (
          <section class="mb-8">
            <h2 class="font-display text-2xl font-medium">{section.heading}</h2>
            <ul class="mt-3 list-disc space-y-2 pl-5 leading-relaxed">
              {section.points.map(point => (
                <li>{point}</li>
              ))}
            </ul>
          </section>
        ))
      }

      {
        (guide.forHer || guide.forHim) && (
          <div class="mb-8 grid gap-4 sm:grid-cols-2">
            {guide.forHer && (
              <div class="bg-blossom/15 rounded-2xl p-6">
                <h2 class="font-display text-xl font-medium">For her</h2>
                <ul class="mt-2 list-disc space-y-1.5 pl-5 text-sm leading-relaxed">
                  {guide.forHer.map(item => (
                    <li>{item}</li>
                  ))}
                </ul>
              </div>
            )}
            {guide.forHim && (
              <div class="bg-ocean/10 rounded-2xl p-6">
                <h2 class="font-display text-xl font-medium">For him</h2>
                <ul class="mt-2 list-disc space-y-1.5 pl-5 text-sm leading-relaxed">
                  {guide.forHim.map(item => (
                    <li>{item}</li>
                  ))}
                </ul>
              </div>
            )}
          </div>
        )
      }
    </div>

    <section class="mt-2">
      <h2 class="font-display text-2xl font-medium">
        What to look for, by budget
      </h2>
      <div
        class:list={[
          "mt-4 grid gap-4",
          visibleTiers.length > 1 ? "md:grid-cols-3" : "",
        ]}
      >
        {
          visibleTiers.map(key => (
            <div class="border-border rounded-2xl border p-6">
              <p class="text-muted-foreground text-xs font-medium">
                {tierLabels[key].range}
              </p>
              <h3 class="font-display mt-1 text-xl font-medium">
                {tierLabels[key].name}
              </h3>
              <ul class="mt-3 list-disc space-y-1.5 pl-5 text-sm leading-relaxed">
                {guide.tiers[key].map(item => (
                  <li>{item}</li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </section>

    {
      guide.rules && (
        <section class="bg-muted mt-10 max-w-3xl rounded-2xl p-6">
          <h2 class="font-display text-xl font-medium">Travel rules to know</h2>
          {guide.rules.map(rule => (
            <div class="mt-3 text-sm leading-relaxed">
              <p>{rule.text}</p>
              <p class="text-muted-foreground mt-1 text-xs">
                Source: <a href={rule.url}>{rule.source}</a>. Last checked{" "}
                {rule.lastChecked}. Rules change, so confirm with your airline
                and airport before you travel.
              </p>
            </div>
          ))}
        </section>
      )
    }

    <section class="border-border mt-12 border-t pt-8">
      <h2 class="font-display text-2xl font-medium">More guides</h2>
      <div class="mt-4 grid gap-4 sm:grid-cols-3">
        {
          others.map(g => (
            <a
              href={getRelativeLocaleUrl(locale, `guides/${g.slug}`)}
              class:list={["block rounded-2xl p-5 no-underline", g.tint]}
            >
              <h3 class="font-display text-xl font-medium">{g.title}</h3>
              <p class="mt-1 text-sm">{g.summary}</p>
            </a>
          ))
        }
      </div>
    </section>
  </main>
  <Footer wide />
</Layout>
