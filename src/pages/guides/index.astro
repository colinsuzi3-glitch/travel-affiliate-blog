---
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import { guides, tierLabels } from "@/custom/guides";
import config from "@/config";

const locale = Astro.currentLocale ?? config.site.lang;
---

<Layout
  title={`Guides | ${config.site.title}`}
  description="Practical travel guides: power and plugs, skin and sun, hair care, light clothing, in-flight comfort and bags."
>
  <Header wide />
  <main id="main-content" class="mx-auto my-1 w-full max-w-6xl px-4 pt-8 pb-12">
    <p class="text-accent mb-1 text-sm font-medium">Guides</p>
    <h1 class="font-display text-4xl font-medium">Travel notes that help</h1>
    <p class="text-muted-foreground mt-3 max-w-2xl text-lg leading-relaxed">
      Plain-spoken guides for her, for him and for the friends she travels with.
      Each one is organised by price, from small comforts to pieces worth saving
      for.
    </p>

    <div class="mt-6 flex flex-wrap gap-2 text-sm">
      {
        Object.values(tierLabels).map(tier => (
          <span class="bg-muted rounded-full px-4 py-1.5">
            {tier.name}: {tier.range}
          </span>
        ))
      }
    </div>

    <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        guides.map(guide => (
          <a
            href={getRelativeLocaleUrl(locale, `guides/${guide.slug}`)}
            style={`--guide:${guide.color};--guide-ink:${guide.ink}`}
            class="guide guide-wash guide-card hover:border-accent block overflow-hidden rounded-2xl border border-transparent no-underline transition-colors"
          >
            {guide.image && (
              <div class="relative">
                <img
                  src={guide.image}
                  alt=""
                  loading="lazy"
                  class="aspect-4/5 w-full object-cover"
                  style={`object-position: ${guide.imagePosition ?? "center"}`}
                />
                <span class="guide-stamp bg-background/90 absolute top-3 left-3">
                  No. {guide.number}
                </span>
              </div>
            )}
            <div class="p-5">
              <h2 class="font-display text-2xl font-medium">{guide.title}</h2>
              <span class="guide-route mt-3" />
              <p class="mt-3 text-sm leading-relaxed">{guide.summary}</p>
              <span class="guide-text mt-4 inline-block text-sm font-medium">
                Read the guide
              </span>
            </div>
          </a>
        ))
      }
    </div>
  </main>
  <Footer wide />
</Layout>
