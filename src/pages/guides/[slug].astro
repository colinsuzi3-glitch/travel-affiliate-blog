---
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import { guides, tierLabels } from "@/custom/guides";
import type { Guide } from "@/custom/guides";
import { getPicks, amazonUrl } from "@/custom/picks";
import config from "@/config";

export function getStaticPaths() {
  return guides.map(guide => ({
    params: { slug: guide.slug },
    props: { guide },
  }));
}

const { guide } = Astro.props as { guide: Guide };
const locale = Astro.currentLocale ?? config.site.lang;
const others = guides.filter(g => g.slug !== guide.slug).slice(0, 3);
const tierKeys = ["small", "upgrade", "saving"] as const;
const visibleTiers = tierKeys.filter(key => guide.tiers[key].length > 0);
const guidePicks = getPicks(guide.slug);
---

<Layout
  title={`${guide.title} | ${config.site.title}`}
  description={guide.summary}
>
  <Header wide />
  <main id="main-content" class="mx-auto my-1 w-full max-w-6xl px-4 pb-12">
    <a
      href={getRelativeLocaleUrl(locale, "guides")}
      class="text-accent mt-6 inline-block text-sm no-underline hover:underline"
    >
      All guides
    </a>

    <header
      class:list={[
        "relative mt-4 overflow-hidden rounded-2xl p-8 sm:p-12",
        guide.tint,
      ]}
    >
      {
        guide.image && (
          <>
            <img
              src={guide.image}
              alt=""
              aria-hidden="true"
              class="absolute inset-0 h-full w-full object-cover opacity-45"
              style={`object-position: ${guide.imagePosition ?? "center"}`}
            />
            <div class="from-background/95 via-background/70 absolute inset-0 bg-gradient-to-r to-transparent" />
          </>
        )
      }
      <div class="relative">
        <div class="flex flex-wrap gap-2">
          {
            guide.audience.map(a => (
              <span class="bg-blossom/40 rounded-full px-3 py-1 text-xs font-medium">
                {a}
              </span>
            ))
          }
        </div>
        <h1 class="font-display mt-3 text-4xl font-medium sm:text-5xl">
          {guide.title}
        </h1>
        <span class="bg-accent/60 mt-4 block h-0.5 w-12 rounded-full"></span>
        <p class="mt-4 max-w-xl text-lg leading-relaxed">{guide.intro}</p>
      </div>
    </header>

    {
      guidePicks.length > 0 && (
        <section class="mt-8">
          <h2 class="font-display text-2xl font-medium">At a glance</h2>
          <div class="border-border mt-3 overflow-x-auto rounded-2xl border">
            <table class="w-full text-left text-sm">
              <thead class="bg-blossom/15">
                <tr>
                  <th class="px-4 py-3 font-medium">For</th>
                  <th class="px-4 py-3 font-medium">Our pick</th>
                  <th class="px-4 py-3 font-medium">Budget</th>
                </tr>
              </thead>
              <tbody>
                {guidePicks.map(pick => (
                  <tr class="border-border border-t">
                    <td class="px-4 py-3">{pick.item}</td>
                    <td class="px-4 py-3 font-medium">{pick.name}</td>
                    <td class="text-muted-foreground px-4 py-3">
                      {tierLabels[pick.tier].range}
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </section>
      )
    }

    <div class="mt-10 max-w-3xl">
      {
        guide.sections.map(section => (
          <section class="mb-8">
            <h2 class="font-display text-2xl font-medium">{section.heading}</h2>
            <ul class="mt-3 list-disc space-y-2 pl-5 leading-relaxed">
              {section.points.map(point => (
                <li>{point}</li>
              ))}
            </ul>
          </section>
        ))
      }

      {
        (guide.forHer || guide.forHim) && (
          <div class="mb-8 grid gap-4 sm:grid-cols-2">
            {guide.forHer && (
              <div class="bg-blossom/15 rounded-2xl p-6">
                <h2 class="font-display text-xl font-medium">For her</h2>
                <ul class="mt-2 list-disc space-y-1.5 pl-5 text-sm leading-relaxed">
                  {guide.forHer.map(item => (
                    <li>{item}</li>
                  ))}
                </ul>
              </div>
            )}
            {guide.forHim && (
              <div class="bg-ocean/10 rounded-2xl p-6">
                <h2 class="font-display text-xl font-medium">For him</h2>
                <ul class="mt-2 list-disc space-y-1.5 pl-5 text-sm leading-relaxed">
                  {guide.forHim.map(item => (
                    <li>{item}</li>
                  ))}
                </ul>
              </div>
            )}
          </div>
        )
      }
    </div>

    <section class="mt-2">
      <h2 class="font-display text-2xl font-medium">
        What to look for, by budget
      </h2>
      <div
        class:list={[
          "mt-4 grid gap-4",
          visibleTiers.length > 1 ? "md:grid-cols-3" : "",
        ]}
      >
        {
          visibleTiers.map(key => (
            <div class="border-border rounded-2xl border p-6">
              <p class="text-muted-foreground text-xs font-medium">
                {tierLabels[key].range}
              </p>
              <h3 class="font-display mt-1 text-xl font-medium">
                {tierLabels[key].name}
              </h3>
              <ul class="mt-3 list-disc space-y-1.5 pl-5 text-sm leading-relaxed">
                {guide.tiers[key].map(item => (
                  <li>{item}</li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </section>

    {
      guidePicks.length > 0 && (
        <section class="mt-12">
          <h2 class="font-display text-2xl font-medium">Our picks</h2>
          <p class="text-muted-foreground mt-2 max-w-2xl text-sm leading-relaxed">
            As an Amazon Associate I earn from qualifying purchases. Links below
            are affiliate links. Prices change, so check the current price on
            the retailer's page.
          </p>
          <div class="mt-4 grid gap-4 md:grid-cols-2">
            {guidePicks.map(pick => (
              <div class="border-border rounded-2xl border p-6">
                {pick.imageUrl && (
                  <img
                    src={pick.imageUrl}
                    alt={pick.name}
                    loading="lazy"
                    class="mb-4 aspect-4/3 w-full rounded-xl object-contain"
                  />
                )}
                <p class="text-muted-foreground text-xs font-medium">
                  {tierLabels[pick.tier].name} · {pick.item}
                </p>
                <h3 class="font-display mt-1 text-xl font-medium">
                  {pick.name}
                </h3>
                <p class="mt-2 text-sm leading-relaxed">{pick.why}</p>
                {pick.watchFor && (
                  <p class="text-muted-foreground mt-2 text-sm leading-relaxed">
                    Worth knowing: {pick.watchFor}
                  </p>
                )}
                <a
                  href={amazonUrl(pick.asin as string)}
                  rel="sponsored nofollow noopener"
                  target="_blank"
                  class="bg-gold/40 mt-4 inline-block rounded-full px-4 py-2 text-sm font-medium no-underline"
                >
                  See it on Amazon.ca
                </a>
              </div>
            ))}
          </div>
        </section>
      )
    }

    {
      guidePicks.length > 0 && (
        <section class="bg-muted mt-10 max-w-3xl rounded-2xl p-6">
          <h2 class="font-display text-xl font-medium">How we choose</h2>
          <p class="mt-2 text-sm leading-relaxed">
            We start with the things travellers buy most, keep only those with
            strong reviews from a large number of buyers, and read what
            independent testers say. We tell you plainly when we have not tried
            something yet. We do not show prices, because they change.
          </p>
        </section>
      )
    }

    {
      guide.rules && (
        <section class="bg-muted mt-10 max-w-3xl rounded-2xl p-6">
          <h2 class="font-display text-xl font-medium">Travel rules to know</h2>
          {guide.rules.map(rule => (
            <div class="mt-3 text-sm leading-relaxed">
              <p>{rule.text}</p>
              <p class="text-muted-foreground mt-1 text-xs">
                Source: <a href={rule.url}>{rule.source}</a>. Last checked{" "}
                {rule.lastChecked}. Rules change, so confirm with your airline
                and airport before you travel.
              </p>
            </div>
          ))}
        </section>
      )
    }

    <section class="border-border mt-12 border-t pt-8">
      <h2 class="font-display text-2xl font-medium">More guides</h2>
      <div class="mt-4 grid gap-4 sm:grid-cols-3">
        {
          others.map(g => (
            <a
              href={getRelativeLocaleUrl(locale, `guides/${g.slug}`)}
              class:list={["block rounded-2xl p-5 no-underline", g.tint]}
            >
              <h3 class="font-display text-xl font-medium">{g.title}</h3>
              <p class="mt-1 text-sm">{g.summary}</p>
            </a>
          ))
        }
      </div>
    </section>
  </main>
  <Footer wide />
</Layout>
