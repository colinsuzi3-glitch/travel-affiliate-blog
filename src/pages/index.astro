---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Card from "@/components/Card.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { getPostUrl } from "@/utils/getPostPaths";
import { useTranslations } from "@/i18n";
import { guides } from "@/custom/guides";
import config from "@/config";

const { posts: postsConfig } = config;

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

const posts = await getCollection("posts");
const sortedPosts = getSortedPosts(posts);
const featuredStory =
  sortedPosts.find(({ data }) => data.featured) ?? sortedPosts[0];
const moreStories = sortedPosts
  .filter(p => p.id !== featuredStory?.id)
  .slice(0, postsConfig.perIndex);
const homePath = getRelativeLocaleUrl(locale, "");

const existingTags = new Set(sortedPosts.flatMap(({ data }) => data.tags));
const storyTypes = [
  { slug: "reaching-out", label: "Reaching out" },
  { slug: "taste", label: "Taste" },
  { slug: "sound", label: "Sound" },
  { slug: "wonder", label: "Wonder" },
];

const doors = [
  {
    title: "For her",
    text: "Skin, hair and makeup know-how for the carry-on: what fits, what passes security and what travels well.",
    tint: "bg-blossom/15 text-foreground",
    image: "/images/carryon-bag.jpg",
    alt: "A clear zip bag of small unbranded toiletries on a linen bedspread, with a passport and a packing list",
  },
  {
    title: "For him",
    text: "Packing and grooming notes for him: simple, tidy and easy to feel good about.",
    tint: "bg-ocean/10 text-foreground",
  },
  {
    title: "With her girls",
    text: "Group trips made easy: who packs what, what clears security, and how to keep everyone's budget and plans happy.",
    tint: "bg-gold/20 text-foreground",
    image: "/images/girls-poolside.jpg",
    alt: "Three friends in white robes laughing together beside a pool",
  },
];
---

<Layout>
  <Header wide />
  <main
    id="main-content"
    data-layout="index"
    data-home-path={homePath}
    class="mx-auto my-1 w-full max-w-6xl px-4"
  >
    <section
      id="hero"
      class="grid items-center gap-8 py-10 md:grid-cols-2 md:py-16"
    >
      <div>
        <p class="text-accent mb-3 text-sm font-medium tracking-wide">
          Stories and practical notes for the way you travel
        </p>
        <h1 class="font-display text-4xl leading-tight font-medium sm:text-5xl">
          Travel well.<br />Feel well.
        </h1>
        <p class="text-muted-foreground mt-5 max-w-md text-lg leading-relaxed">
          Travel with an open heart and bring something beautiful home. Honest
          stories from the road, and practical notes for those who love to
          explore.
        </p>
        <div class="mt-7 flex flex-wrap gap-3">
          <a
            href={getRelativeLocaleUrl(locale, "posts")}
            class="bg-gold text-gold-foreground rounded-full px-6 py-3 text-sm font-medium no-underline transition-opacity hover:opacity-90"
          >
            Read the Journal
          </a>
          <a
            href={getRelativeLocaleUrl(locale, "about")}
            class="border-border hover:border-accent hover:text-accent rounded-full border px-6 py-3 text-sm font-medium no-underline transition-colors"
          >
            About Travel Well
          </a>
        </div>
      </div>
      <div class="overflow-hidden rounded-2xl">
        <img
          src="/images/hammock-porch.jpg"
          width="1248"
          height="832"
          alt="A couple laughing together in a rope hammock under palm trees, with the sea behind them"
          class="aspect-4/3 w-full object-cover"
          fetchpriority="high"
        />
      </div>
    </section>

    <section id="doors" class="pb-10">
      <h2 class="font-display text-3xl font-medium">
        However you travel, travel well
      </h2>
      <p class="text-muted-foreground mt-2 max-w-xl">
        Practical, plain-spoken notes for her, for him and for the friends she
        travels with.
      </p>
      <div class="mt-6 grid gap-4 sm:grid-cols-3">
        {
          doors.map(door => (
            <div class:list={["overflow-hidden rounded-2xl", door.tint]}>
              {door.image && (
                <img
                  src={door.image}
                  width="1248"
                  height="832"
                  alt={door.alt}
                  class="aspect-3/2 w-full object-cover"
                  loading="lazy"
                />
              )}
              <div class="p-6">
                <h3 class="font-display text-2xl font-medium">{door.title}</h3>
                <p class="mt-2 text-sm leading-relaxed">{door.text}</p>
              </div>
            </div>
          ))
        }
      </div>
      <div class="mt-10 flex flex-wrap items-end justify-between gap-3">
        <h3 class="font-display text-xl font-medium">Guides</h3>
        <a
          href={getRelativeLocaleUrl(locale, "guides")}
          class="text-accent text-sm font-medium no-underline hover:underline"
        >
          All guides
        </a>
      </div>
      <div class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {
          guides.map(guide => (
            <a
              href={getRelativeLocaleUrl(locale, `guides/${guide.slug}`)}
              class:list={[
                "hover:border-accent block rounded-2xl border border-transparent p-5 no-underline transition-colors",
                guide.tint,
              ]}
            >
              <h4 class="font-display text-xl font-medium">{guide.title}</h4>
              <p class="mt-1.5 text-sm leading-relaxed">{guide.summary}</p>
            </a>
          ))
        }
      </div>
    </section>

    {
      featuredStory && (
        <section id="journal" class="border-border border-t py-12">
          <div class="flex flex-wrap items-end justify-between gap-4">
            <div>
              <p class="text-accent mb-1 text-sm font-medium">The Journal</p>
              <h2 class="font-display text-3xl font-medium">
                Small moments from the road
              </h2>
            </div>
            <div class="flex flex-wrap gap-2">
              {storyTypes.map(type =>
                existingTags.has(type.slug) ? (
                  <a
                    href={getRelativeLocaleUrl(locale, `tags/${type.slug}`)}
                    class="bg-muted hover:text-accent rounded-full px-4 py-1.5 text-sm no-underline"
                  >
                    {type.label}
                  </a>
                ) : (
                  <span class="bg-muted text-muted-foreground rounded-full px-4 py-1.5 text-sm">
                    {type.label}
                  </span>
                )
              )}
            </div>
          </div>

          <a
            href={getPostUrl(
              featuredStory.id,
              featuredStory.filePath,
              Astro.currentLocale
            )}
            class="border-border bg-muted/40 mt-8 grid overflow-hidden rounded-2xl border no-underline md:grid-cols-5"
          >
            <img
              src="/images/carnival-night.jpg"
              width="1088"
              height="1211"
              alt="A dancer in a turquoise carnival costume laughing on a beachfront at night"
              class="h-full max-h-96 w-full object-cover md:col-span-2 md:max-h-none"
              loading="lazy"
            />
            <div class="p-6 sm:p-10 md:col-span-3">
              <p class="text-accent text-sm font-medium">Featured story</p>
              <h3 class="font-display mt-2 text-3xl leading-tight font-medium">
                {featuredStory.data.title}
              </h3>
              <p class="text-muted-foreground mt-3 text-lg leading-relaxed">
                {featuredStory.data.description}
              </p>
              <span class="text-accent mt-5 inline-flex items-center gap-1 text-sm font-medium">
                Read the story
                <IconArrowRight class="inline-block rtl:-rotate-180" />
              </span>
            </div>
          </a>

          {moreStories.length > 0 && (
            <ul class="mt-4 max-w-3xl">
              {moreStories.map(data => (
                <Card variant="h3" {...data} />
              ))}
            </ul>
          )}
        </section>
      )
    }

    <section
      id="packing-note"
      class="bg-sage/25 my-6 rounded-2xl px-6 py-12 text-center sm:px-12"
    >
      <p class="text-accent text-sm font-medium">A note on packing</p>
      <h2
        class="font-display mx-auto mt-2 max-w-xl text-3xl leading-tight font-medium sm:text-4xl"
      >
        Take what you need. Leave room for the unexpected.
      </h2>
      <p class="text-muted-foreground mx-auto mt-4 max-w-lg">
        The best packing list is rarely the longest. Start with a dependable
        bag, build around things you will actually use, and keep space for the
        moments you did not plan.
      </p>
    </section>

    <div class="my-10 text-center">
      <a
        href={getRelativeLocaleUrl(locale, "posts")}
        class="border-border hover:border-accent hover:text-accent inline-flex items-center gap-1 rounded-full border px-6 py-3 text-sm font-medium no-underline transition-colors"
      >
        {t.home.allPosts}
        <IconArrowRight class="inline-block rtl:-rotate-180" />
      </a>
    </div>
  </main>
  <Footer wide />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset;
    const baseRoot = import.meta.env.BASE_URL.replace(/\/?$/, "/");
    if (indexLayout?.layout) {
      sessionStorage.setItem("backUrl", indexLayout.homePath ?? baseRoot);
    }
  });
</script>
