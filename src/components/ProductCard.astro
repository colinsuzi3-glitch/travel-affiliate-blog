---
interface Props {
  title: string;
  brand?: string;
  badge?: string;
  image?: string;
  summary: string;
  pros?: string[];
  link: string;
  buttonText?: string;
}

const {
  title,
  brand,
  badge = "Carry-On Favorite",
  image,
  summary,
  pros = [],
  link,
  buttonText = "Check Current Price",
} = Astro.props;
---

<aside class="border-border bg-muted/60 my-8 rounded-xl border p-6 shadow-xs">
  <div class="flex flex-col gap-6 sm:flex-row sm:items-center">
    {
      image && (
        <div class="w-full shrink-0 sm:w-44">
          <img
            src={image}
            alt={title}
            loading="lazy"
            class="border-border bg-background aspect-square w-full rounded-lg border object-cover"
          />
        </div>
      )
    }

    <div class="flex-1">
      <div class="mb-2 flex flex-wrap items-center gap-2">
        <span
          class="bg-accent/15 text-accent rounded-full px-3 py-0.5 text-xs font-semibold tracking-wide uppercase"
        >
          {badge}
        </span>
        {
          brand && (
            <span class="text-muted-foreground text-xs tracking-wider uppercase">
              {brand}
            </span>
          )
        }
      </div>

      <h3 class="text-foreground mt-1 mb-2 text-2xl font-bold">
        {title}
      </h3>

      <p class="text-foreground/90 mb-3 text-sm leading-relaxed">
        {summary}
      </p>

      {
        pros.length > 0 && (
          <ul class="text-foreground/85 mb-4 space-y-1 text-sm">
            {pros.map(item => (
              <li class="flex items-start gap-2">
                <span class="text-accent font-bold">✓</span>
                <span>{item}</span>
              </li>
            ))}
          </ul>
        )
      }

      <a
        href={link}
        target="_blank"
        rel="nofollow sponsored noopener"
        class="bg-accent text-accent-foreground inline-block rounded-lg px-5 py-2.5 text-sm font-semibold no-underline transition hover:opacity-90"
      >
        {buttonText} →
      </a>
    </div>
  </div>
</aside>
